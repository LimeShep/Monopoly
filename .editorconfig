root = true

[*.cs]

# Indentation
indent_style = space
indent_size = 4
tab_width = 4

# New lines
end_of_line = crlf
insert_final_newline = true

# Braces
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Namespace
csharp_style_namespace_declarations = file_scoped:suggestion

# Expression bodies
csharp_style_expression_bodied_methods = when_possible:suggestion
csharp_style_expression_bodied_accessors = when_possible:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion
csharp_style_expression_bodied_constructors = when_possible:suggestion

# var
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# Expression preferences
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Names
dotnet_naming_rule.private_members_lowercase.severity = suggestion
dotnet_naming_rule.private_members_lowercase.symbols = private_members
dotnet_naming_rule.private_members_lowercase.style = lowercase

dotnet_naming_symbols.private_members.applicable_kinds = field,method,property
dotnet_naming_symbols.private_members.applicable_accessibilities = private

dotnet_naming_style.lowercase.capitalization = camel_case

# Public members
dotnet_naming_rule.public_members_pascal_case.severity = warning
dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case

dotnet_naming_symbols.public_members.applicable_kinds = field,method,property,class,struct,enum,interface
dotnet_naming_symbols.public_members.applicable_accessibilities = public

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_diagnostic.IDE0031.severity = none

# IDE0040: Add accessibility modifiers
dotnet_diagnostic.IDE0040.severity = none


# IDE0040: Add accessibility modifiers
dotnet_style_require_accessibility_modifiers = never


# IDE0040: Add accessibility modifiers
dotnet_style_require_accessibility_modifiers = never
